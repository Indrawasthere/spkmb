{
    "name": "sip-kbpj",
    "private": true,
    "version": "2.0.1",
    "type": "module",
    "homepage": "https://sipakat-bpj.com",
    "scripts": {
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "dev:client": "vite",
        "dev:server": "tsx watch src/server.ts",
        "server": "tsx src/server.ts",
        "build": "npm run build:client && npm run build:server",
        "build:client": "vite build",
        "build:server": "tsc -p tsconfig.server.json",
        "start": "NODE_ENV=production node dist/server.js",
        "deploy": "npm run build && npm run db:migrate:deploy",
        "demo": "node demo.js",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "preview": "vite preview",
        "type-check": "tsc --noEmit",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:seed": "tsx prisma/seed.ts",
        "db:reset": "prisma migrate reset --force",
        "pm2:dev": "pm2 start npm --name sipkpbj-dev -- run dev",
        "pm2:dev:stop": "pm2 stop sipkpbj-dev",
        "pm2:dev:restart": "pm2 restart sipkpbj-dev",
        "pm2:dev:delete": "pm2 delete sipkpbj-dev",
        "pm2:dev:logs": "pm2 logs sipkpbj-dev",
        "pm2:dev:monit": "pm2 monit",
        "pm2:prod": "pm2 start npm --name sipkpbj-api -- start",
        "pm2:prod:stop": "pm2 stop sipkpbj-api",
        "pm2:prod:restart": "pm2 restart sipkpbj-api",
        "pm2:prod:delete": "pm2 delete sipkpbj-api",
        "pm2:prod:logs": "pm2 logs sipkpbj-api",
        "pm2:list": "pm2 list",
        "pm2:monit": "pm2 monit",
        "pm2:flush": "pm2 flush",
        "pm2:kill": "pm2 kill"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@eslint/js": "^9.38.0",
        "@fullcalendar/core": "^6.1.19",
        "@fullcalendar/daygrid": "^6.1.19",
        "@fullcalendar/interaction": "^6.1.19",
        "@fullcalendar/list": "^6.1.19",
        "@fullcalendar/react": "^6.1.19",
        "@fullcalendar/timegrid": "^6.1.19",
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^5.2.2",
        "@mui/icons-material": "^7.3.5",
        "@mui/material": "^7.3.5",
        "@ngrok/ngrok": "^1.5.2",
        "@prisma/client": "^6.19.0",
        "@react-jvectormap/core": "^1.0.4",
        "@react-jvectormap/world": "^1.1.2",
        "@sentry/react": "^10.25.0",
        "@sentry/tracing": "^7.120.4",
        "@tailwindcss/forms": "^0.5.10",
        "@tanstack/react-table": "^8.21.3",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.9.1",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@types/react-flatpickr": "^3.8.11",
        "@vitejs/plugin-react": "^4.7.0",
        "apexcharts": "^4.7.0",
        "autoprefixer": "^10.4.21",
        "bcrypt": "^6.0.0",
        "chalk": "^5.6.2",
        "classnames": "^2.5.1",
        "clsx": "^2.1.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.3",
        "eslint": "^9.38.0",
